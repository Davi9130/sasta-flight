TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id
TIMEZONE=America/Sao_Paulo
CURRENCY=BRL
DAYS_TO_SCAN=30
TOP_CHEAPEST=5
MAX_AIRPORT_COMBOS=4
ENABLE_SPLIT_TICKETS=0
ALWAYS_SEND_SCAN_SUMMARY=0
DEFAULT_ALERT_COOLDOWN_MINUTES=360

# Anti-block. Leave PROXY_URLS empty for a direct connection (conservative defaults apply).
# Comma-separated, e.g. http://user:pass@host:port,socks5://user:pass@host2:port
PROXY_URLS=
# Request budgets (defaults depend on whether proxies are configured)
# REQ_BUDGET_PER_SCAN=25
# REQ_BUDGET_PER_HOUR=60
# REQ_BUDGET_PER_DAY=400
# REQ_JITTER_MIN_SECS=4
# REQ_JITTER_MAX_SECS=9
# BLOCK_COOLDOWN_SECS=1800
# BLOCK_COOLDOWN_MAX_SECS=21600
# PROXY_QUARANTINE_SECS=1800
# QUOTE_CACHE_TTL_MINS=180
# SCHEDULE_JITTER_MINS=10

# Date sampling
# COARSE_STEP_DAYS=3
# REFINE_TOP_K=3
# REFINE_RADIUS_DAYS=2
# VIA_BUDGET_PER_SCAN=40
# VIA_LONGHAUL_HUBS=GRU,GIG
